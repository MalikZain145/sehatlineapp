{
  "expo": {
    "name": "SehatLine",
    "slug": "sehatline",
    "version": "5.3.1",
    "orientation": "portrait",
    "scheme": "sehatline",
    "icon": "./assets/sehatline-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-native.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sehatline.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "SehatLine needs camera access to capture your CNIC for verification.",
        "NSFaceIDUsageDescription": "SehatLine uses Face ID / Touch ID to securely log you in.",
        "NSPhotoLibraryUsageDescription": "SehatLine does not use your gallery for CNIC; camera capture is required.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.sehatline.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "SehatLine needs camera access to capture your CNIC for verification."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SehatLine uses Face ID / Touch ID to securely log you in."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0BAA9D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SehatLine uses the camera to verify your CNIC."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ed02123a-39a8-479a-91bd-aa0043d5ecf8"
      }
    }
  }
}
