# SehatLine backend environment — COPY this file to ".env" and fill in values.
# (The real .env with live credentials is intentionally NOT shared.)

# Server
PORT=5000
NODE_ENV=development

# Database — put YOUR OWN MongoDB connection string here.
#   • Local Mongo:  mongodb://127.0.0.1:27017/sehatline
#   • Atlas (free): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/sehatline
MONGO_URI=mongodb://127.0.0.1:27017/sehatline

# Auth — use any long random strings for local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_INACTIVITY_MINUTES=5

# ML priority service (optional). Leave false if you don't need it.
ML_AUTOSTART=false

# Email (optional — only needed for password-reset / notification emails).
# Leave blank to disable email locally.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=SehatLine <no-reply@sehatline.app>
